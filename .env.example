# Dodo Payments checkout API key. Prefer this official variable name.
DODO_PAYMENTS_API_KEY=

# Use test_mode while testing and live_mode only for real payments.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Product IDs from Dodo Payments. PROFESSIONAL is optional until that plan exists.
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PROFESSIONAL=

# Signing secret copied from Developer > Webhooks for this exact endpoint.
DODOPAYMENTS_WEBHOOK_SECRET=

# Public deployment origin, without a trailing slash.
# In production set NEXT_PUBLIC_BASE_URL=https://lessonmap.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-only DeepSeek credential. Never prefix this with NEXT_PUBLIC_.
# Leave blank to show AI generation as unavailable until configured.


# Better Auth: server-only secrets and the PostgreSQL connection string.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Protects the daily abandoned-upload cleanup job (Vercel sends this automatically).
# Generate a separate random value: openssl rand -hex 32
CRON_SECRET=
