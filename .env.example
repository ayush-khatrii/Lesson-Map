# Dodo Payments checkout API key. Prefer this official variable name.
DODO_PAYMENTS_API_KEY=

# Use test_mode while testing and live_mode only for real payments.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Product IDs from Dodo Payments. PROFESSIONAL is optional until that plan exists.
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PROFESSIONAL=

# Signing secret copied from Developer > Webhooks for this exact endpoint.
DODOPAYMENTS_WEBHOOK_SECRET=

# Public deployment origin, without a trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
