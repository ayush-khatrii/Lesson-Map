generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  Course        Course[]
  accounts      Account[]
  sessions      Session[]
  aiGenerations AiGeneration[]
  adminAccess   AdminAccess?
  adminSessions AdminSession[]

  plan                          Plan      @default(FREE)
  subscriptionId                String?   @unique
  customerId                    String?   @unique
  subscriptionStatus            String?
  subscriptionProductId         String?
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean   @default(false)

  // Public profile links, shown at the bottom of every shared course page.
  // All optional and stored as absolute URLs.
  socialInstagram String?
  socialLinkedin  String?
  socialYoutube   String?
  socialGithub    String?
  socialTwitter   String?
  socialWebsite   String?

  @@map("user")
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

model Example {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String? // "Programming", "Design", "Business", etc.
  tags           String[] // ["react", "beginner", "web-dev"]
  templateData   Json     @default("{}")
  isPublished    Boolean  @default(true)
  difficulty     String? // "beginner", "intermediate", "advanced"
  estimatedHours Int? // Estimated time to complete
  usageCount     Int      @default(0)
  createdBy      String? // Admin user who created it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("example")
}

model Course {
  id          String   @id @default(cuid())
  courseName  String
  description String
  audience    String?
  isPublic    Boolean  @default(false)
  isPublished Boolean  @default(false)
  shareSlug   String?  @unique
  // Per-course control over the creator's social links on the public page.
  showSocialLinks Boolean @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  Module      Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// No prompt or generated text is stored here. Failed attempts are recorded so
// they can be replayed safely, but they never count against the monthly allowance.
model AiGeneration {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId        String
  inputHash        String
  status           AiGenerationStatus @default(PENDING)
  courseId         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Module {
  id          String   @id @default(cuid())
  description String
  moduleName  String
  order       Int
  courseId    String
  Lesson      Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Lesson {
  id          String     @id @default(cuid())
  lessonName  String
  description String?
  order       Int
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

model Resource {
  id          String       @id @default(cuid())
  name        String
  type        ResourceType
  meta        String?
  content     String?
  url         String?
  key         String?
  filename    String?
  contentType String?
  size        Int?
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([lessonId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum Plan {
  FREE
  CREATOR
  PROFESSIONAL
}

enum ResourceType {
  Code
  PDF
  Link
  Note
  Image
  Document
  Spreadsheet
}

// Shared authentication throttling across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// Kept separate from User so public authentication never exposes privileges or MFA.
model AdminAccess {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               AdminRole @default(ADMIN)
  active             Boolean  @default(true)
  totpSecret         String?
  pendingSecret      String?
  pendingExpiresAt   DateTime?
  totpEnabledAt      DateTime?
  lastCounter        BigInt?
  securityVersion    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recoveryCodes      AdminRecoveryCode[]
}

model AdminSession {
  id              String   @id
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  verifiedAt      DateTime?
  lastActivityAt  DateTime?
  verifiedVersion Int?

  @@index([userId])
  @@index([expiresAt])
}

model AdminVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AdminRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model AdminRecoveryCode {
  id         String   @id @default(cuid())
  accessId   String
  access     AdminAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  hash       String   @unique
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([accessId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Only complete Dodo responses are cached; failed reads never replace real totals.
model AdminReportCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}
